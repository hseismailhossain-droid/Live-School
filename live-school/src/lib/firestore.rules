rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Live Job Preparation / SmartQuiz app data collections
    match /app_data/{docId} {
      // Allow read and write for questions, live exams, categories, banners, settings, etc.
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
